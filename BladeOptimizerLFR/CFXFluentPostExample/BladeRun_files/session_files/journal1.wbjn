# encoding: utf-8
# 2020 R2
SetScriptVersion(Version="20.2.221")
fileType1 = GetFileType(Name="GeometryFileType")
ImportFile(
    FilePath="D:/Ansys/Blade参数化建模工具/BladeOptimizerLFR/CQ/Nurbs泵流体域.scdoc",
    FileType=fileType1)
template1 = GetTemplate(TemplateName="Mesh")
system1 = GetSystem(Name="Geometry")
system2 = template1.CreateSystem(
    Position="Right",
    RelativeTo=system1)
geometryComponent1 = system2.GetComponent(Name="Geometry")
geometryComponent2 = system1.GetComponent(Name="Geometry")
geometryComponent1.ReplaceWithShare(
    TargetSystem=system2,
    ComponentToShare=geometryComponent2,
    SourceSystem=system1)
meshComponent1 = system2.GetComponent(Name="Mesh")
meshComponent1.Refresh()
mesh1 = system2.GetContainer(ComponentName="Mesh")
mesh1.Edit()
mesh1.Exit()
template2 = GetTemplate(TemplateName="CFX")
system3 = template2.CreateSystem(
    Position="Right",
    RelativeTo=system2)
setupComponent1 = system3.GetComponent(Name="Setup")
meshComponent1.TransferData(TargetComponent=setupComponent1)
setup1 = system3.GetContainer(ComponentName="Setup")
setup1.Edit()
setupComponent1.Refresh()
setup1.Exit()
setupComponent1.Update(AllDependencies=True)
setup1.Edit()
setup1.SendCommand(Command="""VIEW:View 1
  Camera Mode = User Specified
  CAMERA:
    Option = Pivot Point and Quaternion
    Pivot Point = 3.27418e-11, 0, 6.25e-05
    Scale = 7361.36
    Pan = 0, 0
    Rotation Quaternion = -0.208747, -0.168364, -0.315537, 0.910227
    
  END

END

